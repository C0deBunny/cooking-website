{
  "name": "cooking-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "db:types": "supabase gen types typescript --linked > types/database.ts && prettier --write types/database.ts && node scripts/gen-schema-doc.mjs && prettier --write docs/schema-current.html",
    "db:doc": "node scripts/gen-schema-doc.mjs && prettier --write docs/schema-current.html"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.1",
    "supabase": "^2.78.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5"
  }
}
